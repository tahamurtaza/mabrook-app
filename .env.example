# Postgres connection string.
# Locally: postgresql://postgres:postgres@localhost:5432/mabrook
# On Railway: reference the Postgres service with ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mabrook"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"
