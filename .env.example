# Postgres connection string. Required.
#
# Locally, with `npm run db:local`:
#   postgresql://postgres:postgres@127.0.0.1:5432/postgres
# On Railway, reference the Postgres service rather than pasting a URL:
#   ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# The timezone the calendar's "today" is measured in. Optional; defaults to
# Asia/Kolkata. Containers run in UTC, so without this an evening occasion can
# show up a day late.
APP_TIME_ZONE="Asia/Kolkata"

# No session secret is needed. Sessions are rows in the database keyed by a
# 32-byte random token in an httpOnly cookie — there is no signed payload to
# protect, so there is nothing to configure here.
